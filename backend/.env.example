# Copy this file to .env for local development (Render sets these as
# dashboard environment variables instead — you don't upload .env there).

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL is provided automatically by Render's managed Postgres.
# Leave unset locally to use SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
